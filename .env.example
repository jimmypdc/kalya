# ─────────────────────────────────────────────────────────────
# Kayla Marie Joiner Foundation — Environment Variables
# Copy this file to `.env.local` and fill in your real values.
# NEVER commit `.env.local`.
# ─────────────────────────────────────────────────────────────

# ── Site ──────────────────────────────────────────────────────
# The public base URL of the deployed site (no trailing slash).
# Used for Stripe redirect URLs and SEO metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────
# Project URL and keys from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — SERVER ONLY. Bypasses Row Level Security.
# Used by the Stripe webhook to insert donor/donation records.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe ────────────────────────────────────────────────────
# Secret key from: Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# Publishable key (safe for the browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx

# Webhook signing secret from: Stripe Dashboard → Developers → Webhooks
# (or from `stripe listen` when testing locally)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
